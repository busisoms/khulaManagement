# Copy to .env and fill in. Never commit .env.

# SQLite file. Relative paths are relative to prisma/schema.prisma.
# Locally: file:./dev.db   On Render/Railway (persistent volume): file:/data/app.db
DATABASE_URL="file:./dev.db"

# LLM advisor (optional). Without LLM_API_KEY the app uses the rule-based advisor ("demo mode").
LLM_PROVIDER=""
LLM_API_KEY=""
LLM_MODEL=""

# Shared passcode that protects write routes and "Reset demo" on the public URL.
DEMO_PASSCODE=""
